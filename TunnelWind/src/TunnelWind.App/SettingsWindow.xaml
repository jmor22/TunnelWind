<Window x:Class="TunnelWind.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel Wind — Settings"
        Width="500" SizeToContent="Height"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Tunnel engine" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
        <TextBlock Text="Manual local proxy ports (0 = auto):" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <TextBlock Text="HTTP" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
            <TextBox x:Name="HttpPortBox" Width="80" Margin="6,0,14,0" Height="24" VerticalContentAlignment="Center"/>
            <TextBlock Text="SOCKS" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
            <TextBox x:Name="SocksPortBox" Width="80" Margin="6,0,0,0" Height="24" VerticalContentAlignment="Center"/>
        </StackPanel>
        <CheckBox x:Name="ExposeLanCheck" Content="Expose local proxies to LAN (0.0.0.0)" FontSize="12"
                  Foreground="{DynamicResource TextDimBrush}"
                  ToolTip="Let other devices on your network use the local HTTP/SOCKS proxies"/>
        <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,4,0,0" FontSize="12"
                  Foreground="{DynamicResource TextDimBrush}"
                  ToolTip="Launch Tunnel Wind automatically when you sign in (per-user, no admin)"/>

        <TextBlock Text="Network" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
        <TextBlock Text="Upstream proxy URL (corporate proxy, port-forward style):" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
        <TextBox x:Name="UpstreamBox" Height="24" Margin="0,4,0,0" VerticalContentAlignment="Center"
                 ToolTip="http://user:pass@host:port — leave empty to disable"/>

        <TextBlock Text="Update channel" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
        <TextBlock Text="Manifest URL (https://.../update.json):" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
        <TextBox x:Name="UpdateBox" Height="24" Margin="0,4,0,0" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="84" Height="28" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="84" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
