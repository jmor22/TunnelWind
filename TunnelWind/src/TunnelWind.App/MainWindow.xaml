<Window x:Class="TunnelWind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tunnel Wind"
        Width="1120" Height="720"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="16" Height="16" Margin="0,0,8,0"
                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="Tunnel Wind" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#161E30" CornerRadius="5" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.0" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="▢" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ============ body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                    <Grid>
                        <StackPanel Margin="12,16,12,0">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="⌂"
                                         Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavServers" Style="{StaticResource NavItem}" Tag="◎"
                                         Content="Servers" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="⚙"
                                         Content="Settings" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" Tag="≡"
                                         Content="Connection log" Checked="Nav_Checked"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SidebarDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SidebarStatus" Text="Not protected" Margin="8,0,0,0"
                                           FontSize="11.5" Foreground="{StaticResource DimBrush}"/>
                            </StackPanel>
                            <TextBlock Text="psiphon-tunnel-core" FontSize="10" Foreground="#5C6880" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ content ============ -->
                <Grid Grid.Column="1">

                    <!-- ================= HOME ================= -->
                    <Grid x:Name="HomePage" Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="24">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="PowerButton" Width="196" Height="196" CornerRadius="98"
                                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2" Cursor="Hand" MouseLeftButtonUp="PowerButton_Click">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path x:Name="PowerGlyph"
                                                  Data="M12,2 L20,5 L20,11 C20,16 16.5,20.5 12,22 C7.5,20.5 4,16 4,11 L4,5 Z"
                                                  Fill="{StaticResource DimBrush}" Width="52" Height="52"
                                                  Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ConnectButtonText" Text="CONNECT" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="StatusText" Text="Not protected" FontSize="28" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,24,0,4"/>
                                    <TextBlock x:Name="RegionHintText" Text="Fastest server · automatic" FontSize="13"
                                               Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                                        <StackPanel Margin="0,0,44,0">
                                            <TextBlock Text="SESSION" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="SessionText" Text="--:--" FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,44,0">
                                            <TextBlock Text="UPLOAD" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="UploadText" Text="0 B" FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="DOWNLOAD" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="DownloadText" Text="0 B" FontSize="17" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="QUICK CONNECT" Style="{StaticResource SectionLabel}" Margin="6,0,0,6"/>
                                    <Button x:Name="FastestButton" Style="{StaticResource QuickRow}" Click="Fastest_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🌐" FontSize="18" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Fastest server" FontSize="13.5" FontWeight="Medium"/>
                                                <TextBlock Text="Automatic selection" FontSize="10.5" Foreground="{StaticResource DimBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="FastestCheck" Grid.Column="2" Text="" FontSize="13"
                                                       Foreground="{StaticResource AccentHiBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <ItemsControl x:Name="FavoritesPanel" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="FavoritesEmpty" Text="Star servers to pin them here."
                                               FontSize="11" Foreground="#5C6880" Margin="10,6,0,2"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Protocol" FontSize="12.5" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock x:Name="ProtocolValue" Grid.Column="1" Text="Automatic" FontSize="12.5"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="HTTP proxy" FontSize="12.5" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock x:Name="PortsHttp" Grid.Column="1" Text="—" FontSize="12.5"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SOCKS proxy" FontSize="12.5" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock x:Name="PortsSocks" Grid.Column="1" Text="—" FontSize="12.5"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="System proxy" FontSize="12.5" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock x:Name="ProxyState" Grid.Column="1" Text="off" FontSize="12.5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ================= SERVERS ================= -->
                    <Grid x:Name="ServersPage" Margin="26" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Servers" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose the country your traffic exits from." FontSize="12.5"
                                       Foreground="{StaticResource DimBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerSearch" Style="{StaticResource Input}" Tag="Search country" TextChanged="ServerSearch_TextChanged"/>
                            <Button Grid.Column="1" x:Name="MeasureButton" Content="Measure latency"
                                    Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Measure_Click"/>
                            <TextBlock Grid.Column="2" x:Name="ServerCountText" Text="" FontSize="11.5"
                                       Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <ListBox Grid.Row="2" x:Name="ServerList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ServerItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseLeftButtonUp="ServerList_MouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="22" CornerRadius="6" Background="{StaticResource FieldBrush}"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Badge}" FontSize="9.5" Foreground="{StaticResource DimBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource DimBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{Binding LatencyBg}" CornerRadius="6"
                                                Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LatencyText}" Foreground="{Binding LatencyFg}" FontSize="11"/>
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Tag="{Binding Code}"
                                                Click="Star_Click" ToolTip="Favorite">
                                            <TextBlock Text="{Binding StarGlyph}" Foreground="{Binding StarFg}" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3" Text="Latency is a TCP handshake to the region's servers over your normal connection."
                                   FontSize="11" Foreground="#5C6880" Margin="0,8,0,0"/>
                    </Grid>

                    <!-- ================= SETTINGS ================= -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="26,26,26,30">
                            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="Connection behaviour, split tunneling and local proxies." FontSize="12.5"
                                       Foreground="{StaticResource DimBrush}" Margin="0,4,0,0"/>

                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionLabel}" Margin="2,22,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Protocol" FontSize="13.5" FontWeight="Medium"/>
                                    <TextBlock Text="Restrict the transports the engine may use. Automatic is best unless a network blocks specific protocols."
                                               FontSize="11.5" Foreground="{StaticResource DimBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="ProtoAuto" GroupName="proto" Content="Automatic" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="ProtoSsh" GroupName="proto" Content="SSH" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="ProtoOssh" GroupName="proto" Content="OSSH" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="ProtoTls" GroupName="proto" Content="TLS-OSSH" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="ProtoQuic" GroupName="proto" Content="QUIC-OSSH" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="ProtoMeek" GroupName="proto" Content="Meek" Style="{StaticResource Segment}"/>
                                    </WrapPanel>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                                    <CheckBox x:Name="SystemProxyCheck" Style="{StaticResource Toggle}" Content="Set the Windows system proxy while connected"/>
                                    <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource Toggle}" Content="Connect automatically at launch" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource Toggle}" Content="Start with Windows" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SPLIT TUNNELING" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <CheckBox x:Name="BypassOwnRegionCheck" Style="{StaticResource Toggle}"
                                              Content="Traffic to my own country bypasses the VPN"/>
                                    <TextBlock Text="Additional countries to bypass (ISO codes, comma separated):"
                                               FontSize="11.5" Foreground="{StaticResource DimBrush}" Margin="0,14,0,6"/>
                                    <TextBox x:Name="BypassRegionsBox" Style="{StaticResource Input}" Width="260" HorizontalAlignment="Left"
                                             ToolTip="e.g. ES, PT"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="LOCAL PROXIES" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="HTTP port" FontSize="11.5" Foreground="{StaticResource DimBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="HttpPortBox" Style="{StaticResource Input}" Width="100"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="SOCKS port" FontSize="11.5" Foreground="{StaticResource DimBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="SocksPortBox" Style="{StaticResource Input}" Width="100"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="0 = let the engine choose a free port." FontSize="11" Foreground="#5C6880" Margin="0,6,0,10"/>
                                    <CheckBox x:Name="ExposeLanCheck" Style="{StaticResource Toggle}"
                                              Content="Expose the proxies to my local network"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ADVANCED" Style="{StaticResource SectionLabel}" Margin="2,20,0,8"/>
                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Upstream proxy (corporate proxy, optional)" FontSize="11.5"
                                               Foreground="{StaticResource DimBrush}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UpstreamBox" Style="{StaticResource Input}" ToolTip="http://user:pass@host:port"/>
                                    <TextBlock Text="Update manifest URL" FontSize="11.5" Foreground="{StaticResource DimBrush}" Margin="0,12,0,5"/>
                                    <TextBox x:Name="UpdateBox" Style="{StaticResource Input}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource GhostButton}" Click="Update_Click"/>
                                        <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="SaveButton" Content="Save &amp; apply" Style="{StaticResource PrimaryButton}" Width="140" Click="Save_Click"/>
                                <TextBlock x:Name="SaveHint" Text="Changes apply immediately; a live tunnel restarts." FontSize="11.5"
                                           Foreground="#5C6880" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= LOGS ================= -->
                    <Grid x:Name="LogsPage" Margin="26" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Connection log" FontSize="26" FontWeight="SemiBold"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                            <Button Content="Copy" Style="{StaticResource GhostButton}" Click="LogCopy_Click"/>
                            <Button Content="Clear" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="LogClear_Click"/>
                            <TextBlock x:Name="LogCountText" Text="" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="3,1"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
