<Window x:Class="TunnelWind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel Wind"
        Width="480" Height="760"
        MinWidth="420" MinHeight="660"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="🌬 Tunnel Wind" FontSize="20" FontWeight="SemiBold"/>
            <Border CornerRadius="4" Background="#262635" Padding="6,2" Margin="10,2,0,0">
                <TextBlock x:Name="VersionText" Text="v1.0" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
            </Border>
        </StackPanel>

        <!-- Connect button -->
        <Button Grid.Row="1" x:Name="ConnectButton"
                Height="64" Margin="0,0,0,12" Background="{StaticResource AccentBrush}"
                Foreground="White" FontSize="18" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand" Click="ConnectButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="14" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHiBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="ConnectButtonText" Text="CONNECT"/>
        </Button>

        <!-- Status row -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusDot" Text="●" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
                <TextBlock x:Name="TrafficText" Text="— —" Margin="22,4,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                <TextBlock x:Name="PortsText" Text="proxy: not connected" Margin="22,2,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Location picker -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SERVER LOCATION" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="RegionHintText" Text="Auto (best performance)"
                               FontSize="12" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" MaxHeight="112" Margin="0,8,0,0">
                    <WrapPanel x:Name="RegionChips"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Split tunnel -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SPLIT TUNNEL" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <CheckBox Grid.Column="1" x:Name="BypassOwnRegionCheck" Content="bypass own country"
                              Foreground="{StaticResource TextDimBrush}" FontSize="11"
                              ToolTip="Connections to your own country's servers go direct, not through the tunnel"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="BypassRegionsBox" Width="160" Height="24" Background="{StaticResource FieldBrush}"
                             Foreground="{StaticResource TextBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Center" Padding="6,0"
                             ToolTip="Country codes whose traffic bypasses the tunnel (comma-separated, e.g. ES,PT)"/>
                    <TextBlock Text="bypass also: ES, PT…" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Log (scroll) -->
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Connection Log" FontWeight="Medium" Margin="6,2,0,6" Foreground="{StaticResource TextDimBrush}"/>
                <ListBox Grid.Row="1" x:Name="LogList" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer options -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox x:Name="SystemProxyCheck" Content="System proxy" IsChecked="True"
                      Foreground="{StaticResource TextDimBrush}" ToolTip="Set Windows system proxy while connected"/>
            <CheckBox x:Name="AutoConnectCheck" Content="Auto-connect at launch" IsChecked="False" Margin="16,0,0,0"
                      Foreground="{StaticResource TextDimBrush}"/>
            <Button Content="⚙" Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                    BorderThickness="0" FontSize="14" Margin="10,0,0,0" ToolTip="Settings" x:Name="SettingsButton" Click="SettingsButton_Click"/>
            <Button Content="⇅" Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                    BorderThickness="0" FontSize="14" Margin="6,0,0,0" ToolTip="Check for updates" x:Name="UpdateButton" Click="UpdateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
