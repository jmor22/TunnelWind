<Application x:Class="TunnelWind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#141420"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#1D1D2B"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
            <SolidColorBrush x:Key="AccentHiBrush" Color="#8878F0"/>
            <SolidColorBrush x:Key="TextBrush" Color="#EAEAF2"/>
            <SolidColorBrush x:Key="TextDimBrush" Color="#9A9AAC"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#E4527A"/>
            <SolidColorBrush x:Key="OkBrush" Color="#3FD48E"/>
            <SolidColorBrush x:Key="FieldBrush" Color="#262635"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
